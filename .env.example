# ===== Aplicación =====
NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:4200

# ===== Base de datos =====
# Por defecto apunta al Postgres del docker-compose.
# Para usar una base de datos REMOTA, cambia estos valores
# (p. ej. DB_HOST=207.180.218.92) y levanta solo backend+frontend.
DB_HOST=db
DB_PORT=5432
DB_USERNAME=cancha
DB_PASSWORD=cancha_secret
DB_DATABASE=cancha
DB_SSL=false
# Ejecutar migraciones/seed al arrancar (el entrypoint de Docker lo hace)
DB_SYNCHRONIZE=false

# ===== Autenticación =====
JWT_SECRET=cambia-esta-clave-super-secreta-en-produccion
JWT_EXPIRES_IN=8h

# ===== Seed del administrador inicial =====
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@comfasucre.com
SEED_ADMIN_PASSWORD=Comfasucre2025*
SEED_ADMIN_NAME=Administrador Comfasucre

# ===== Integraciones externas (adaptadores) =====
# Deja PROVIDER=stub para usar los adaptadores de prueba.
# Pagos: epayco | stub. Mensajería WhatsApp: n8n (intermediario WiseCX) | meta | stub.
# recaudo = intermediario epayco_reacudo_rd (pagos.comfasucre.co) — recomendado
# epayco  = integración directa con ePayco · stub = pagos simulados (pruebas)
PAYMENT_PROVIDER=recaudo
MESSAGING_PROVIDER=n8n
# n8n = webhook de afiliados (el mismo de CLARA); stub = categoría ficticia por el
# último dígito del documento (SOLO pruebas, nunca en producción)
DOCUMENT_LOOKUP_PROVIDER=n8n

# WhatsApp vía n8n (webhook WiseCX) — cuando MESSAGING_PROVIDER=n8n
WHATSAPP_WEBHOOK_URL=https://n8n.iacomfasucre.com/webhook/wisecx-campana-whatsapp
WHATSAPP_CAMPAIGN_ID=
WHATSAPP_AUTHORIZATION=Basic xxxxxxxx
WHATSAPP_WAIT_SECONDS=3
WHATSAPP_PREFIJO_PAIS=
WHATSAPP_TIMEOUT_MS=20000

# ePayco — cuenta "Recreación y Deporte" (cuando PAYMENT_PROVIDER=epayco)
# Tomadas del panel de ePayco: Configuración -> Llaves API y Llaves secretas.
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_P_CUST_ID=1558215
EPAYCO_P_KEY=
EPAYCO_P_ID_ACCOUNT=
EPAYCO_TEST=true
# URL pública de este backend para recibir la confirmación de ePayco (opcional).
EPAYCO_CONFIRMATION_URL=
# Página de confirmación de pago del portal (doble confirmación ePayco + Comfasucre).
# Se agrega ?invoice=<id de la reserva>; ePayco agrega ?ref_payco=. (/reserva también sirve)
EPAYCO_RESPONSE_URL=https://TU-DOMINIO-FRONTEND/pago/confirmacion

# Meta / WhatsApp Cloud API (cuando MESSAGING_PROVIDER=meta)
META_GRAPH_URL=https://graph.facebook.com/v21.0
META_TOKEN=
META_PHONE_NUMBER_ID=
META_TEMPLATE_LANGUAGE=es_MX
# Nombres de las plantillas aprobadas en el WhatsApp Business.
META_TEMPLATE_CODIGO=codigo
META_TEMPLATE_RESERVA=reserva
META_TEMPLATE_RECORDATORIO=recordatorio_pago

# Webhook de afiliados (cuando DOCUMENT_LOOKUP_PROVIDER=n8n): la misma URL que tiene
# CLARA en Configuración → Integraciones → n8n. POST x-www-form-urlencoded
# { numero_identificacion }. Sin respuesta o sin afiliación activa → categoría D.
AFFILIATE_LOOKUP_URL=
# Authorization del webhook (si se omite, usa WHATSAPP_AUTHORIZATION)
AFFILIATE_LOOKUP_AUTHORIZATION=
AFFILIATE_LOOKUP_TIMEOUT_MS=25000

# Horario de atención para la grilla de horarios del portal (horas 0–24, Bogotá)
SCHEDULE_OPEN_HOUR=6
SCHEDULE_CLOSE_HOUR=23

# Carpeta de imágenes subidas desde el panel (en Docker: volumen cancha_uploads)
UPLOADS_DIR=./uploads

# Verificación del celular (OTP por WhatsApp) antes de reservar en el portal
#   n8n  → webhooks enviar-codigo / validar-codigo
#   stub → el código se escribe en el log del backend (solo desarrollo local)
PHONE_VERIFICATION_PROVIDER=n8n
PHONE_VERIFICATION_SEND_URL=https://n8n.iacomfasucre.com/webhook/enviar-codigo
PHONE_VERIFICATION_VALIDATE_URL=https://n8n.iacomfasucre.com/webhook/validar-codigo
# Authorization de enviar-codigo y validar-codigo. Si se omite, usan la misma
# de WHATSAPP_AUTHORIZATION (recomendado: una sola cabecera Basic para todo n8n).
PHONE_VERIFICATION_AUTHORIZATION=
# Solo si validar-codigo necesitara una distinta
PHONE_VERIFICATION_VALIDATE_AUTHORIZATION=
PHONE_VERIFICATION_TIMEOUT_MS=20000
PHONE_VERIFICATION_TOKEN_TTL_MINUTES=30

# ── Pagos vía intermediario epayco_reacudo_rd (PAYMENT_PROVIDER=recaudo) ──
# El intermediario firma con las llaves de ePayco, recibe las confirmaciones y
# valida firma y monto. appCancha crea el checkout y consulta el resultado.
RECAUDO_BASE_URL=https://pagos.comfasucre.co
RECAUDO_API_KEY=
# Cuenta de ePayco: recreacion_deporte | turismo | colegio
RECAUDO_ACCOUNT=recreacion_deporte
RECAUDO_SOURCE_APP=app-cancha
# Vacío = el intermediario decide (EPAYCO_TEST_MODE); true/false para forzarlo
RECAUDO_TEST_MODE=
RECAUDO_TIMEOUT_MS=20000
# Cada cuántos segundos se revisan las reservas con pago pendiente (0 = desactivado)
RECAUDO_RECONCILE_SECONDS=120
# Nota: EPAYCO_RESPONSE_URL (https://<frontend>/pago/confirmacion) es a donde vuelve el cliente,
# y EPAYCO_TEST=false en producción hace que se rechacen transacciones de prueba.
